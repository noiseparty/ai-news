# Admin password for /admin and the API. Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# Public URL, used for RSS links and to mark the session cookie Secure. No trailing slash.
BASE_URL=http://127.0.0.1:8931

PORT=8931
HOST=127.0.0.1

SITE_TITLE=AI Dispatch
SITE_TAGLINE=The AI news worth your time, with notes.
SITE_AUTHOR=
SITE_TZ=Europe/Riga

# For bin/add.js: which server to post to.
AI_NEWS_URL=http://127.0.0.1:8931
